# Settings for the website. Copy this file to .env.local and fill in the blanks. Never commit .env.local.
# The API has its own file, api/.env.example. Nothing here may hold a real secret.

# Auth.js signs its session cookie with this. Any long random string, for example: openssl rand -base64 32
AUTH_SECRET=

# The Google OAuth client the Sign in with Google button uses (Google Cloud console, Credentials).
# The authorized redirect address is <this site's address>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must be the same value as SERVICE_JWT_SECRET in api/.env, at least 32 random characters. The website
# signs a short lived token with it for every call to the API, and the API checks it.
SERVICE_JWT_SECRET=

# Where the API is, from the website's server (not from the browser).
BACKEND_URL=http://localhost:8000

# Where Redis is, for the per person rate limit.
REDIS_URL=redis://localhost:6379

# Outside Vercel, Auth.js refuses requests from a host it was not told to trust and the sign in routes
# answer 500. Set this to true when running the container or any host that is not Vercel.
# AUTH_TRUST_HOST=true
