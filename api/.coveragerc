[run]
source = app
# The database layer runs inside greenlets and some work runs in threads. Without these two the numbers are
# far too low (main.py read 67 percent when it was really 99), because coverage does not follow either by default.
concurrency = greenlet,thread

[report]
show_missing = True
skip_covered = True
# Fails a coverage run that falls below this, so a drop is noticed. It is a floor, not a goal, and 100 percent of lines is not proof of anything.
fail_under = 99
exclude_lines =
    pragma: no cover
    raise AssertionError\("unreachable"\)
