# development, test, or production. Production refuses to start with the built-in secrets.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://brief:brief_dev_password@localhost:5432/brief
# Required, and must match SERVICE_JWT_SECRET in web/.env.local. At least 32 random characters,
# for example from: openssl rand -base64 32
SERVICE_JWT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=brief-documents
R2_ENDPOINT_URL=
GEMINI_API_KEY=
