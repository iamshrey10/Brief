# development, test, or production. Production refuses to start with the built-in secrets.
ENVIRONMENT=development

# text for a terminal, json for a host that collects logs (one JSON object a line).
LOG_FORMAT=text

DATABASE_URL=postgresql+asyncpg://brief:brief_dev_password@localhost:5432/brief
# Required, and must match SERVICE_JWT_SECRET in web/.env.local. At least 32 random characters,
# for example from: openssl rand -base64 32
SERVICE_JWT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=brief-documents
R2_ENDPOINT_URL=
GEMINI_API_KEY=
# How fast Brief may call the model, in total for everyone. The free tier of Gemini allows 15 calls a
# minute, so these stay just under it. After switching to a paid tier, raise them to what it allows.
MODEL_CALLS_PER_MINUTE=14
# Of those, how many a minute are kept for questions, so a few documents being read cannot make
# everyone's questions wait.
MODEL_CALLS_RESERVED_FOR_QUESTIONS=4
MAX_CONCURRENT_MODEL_CALLS=4
# The most model work the whole site does in a day (UTC), counted in calls. Past it Brief says it is busy.
GLOBAL_DAILY_MODEL_CALLS=15000
